# Copy to .env.local for local development with `vercel dev`.
# In production these are set in the Vercel dashboard, never committed.

# Stripe secret key. Use the test key (sk_test_...) until you are ready to
# take real money; swap to sk_live_... at launch.
STRIPE_SECRET_KEY=sk_test_replace_me

# Set to 1 ONLY after Stripe Tax is enabled and your tax registrations are
# added in the Stripe dashboard. Leaving it unset is the safe default.
# STRIPE_TAX=1

# ---------------------------------------------------------------------------
# Order email
# ---------------------------------------------------------------------------

# Signing secret for /api/webhook, from Stripe: Developers -> Webhooks -> your
# endpoint -> "Signing secret". Without it the webhook refuses every delivery,
# because an unverified webhook is a send button for strangers. Each endpoint
# has its own secret, so the test-mode and live-mode ones differ.
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Resend API key, from https://resend.com/api-keys. Without it no order email
# is sent at all — checkout still works, and the failure is logged rather than
# shown to the customer.
RESEND_API_KEY=re_replace_me

# Who both emails come from. Defaults to Compostela <orders@send.compostela.press>,
# which must stay verified in Resend — Resend refuses to send from a domain it
# has not verified, so change it there before changing it here. Set this only
# to move to a different sending address without a deploy.
# ORDER_FROM=Compostela <orders@send.compostela.press>

# Where the internal order alert goes. Defaults to josephrossi613@gmail.com.
# ORDER_ALERT_EMAIL=you@example.com

# Where a customer's reply to their confirmation should land. Left unset,
# replies go to ORDER_FROM — the alert address is never handed out.
# ORDER_REPLY_TO=hello@your-domain.com

# Used for the links in the emails. Vercel sets VERCEL_PROJECT_PRODUCTION_URL
# on its own, so this is only needed elsewhere; with neither set the emails
# simply carry no links.
# SITE_URL=https://your-domain.com

# The confirmation page sends the order emails itself if the webhook has not
# already. Set to 0 to leave it to the webhook alone.
# ORDER_EMAILS_ON_LOOKUP=0
