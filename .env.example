# Copy to .env.local for local development with `vercel dev`.
# In production these are set in the Vercel dashboard, never committed.

# Stripe secret key. Use the test key (sk_test_...) until you are ready to
# take real money; swap to sk_live_... at launch.
STRIPE_SECRET_KEY=sk_test_replace_me

# Set to 1 ONLY after Stripe Tax is enabled and your tax registrations are
# added in the Stripe dashboard. Leaving it unset is the safe default.
# STRIPE_TAX=1
